<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalAxxonData_Installer.Views"
             Width="700"
             x:Class="LocalAxxonData_Installer.Views.ErrorPage">
    <Grid RowDefinitions="*,Auto">

        
        <Border Grid.Row="0" Margin="{StaticResource ThemePaddingDownAndSides-Medium}">
            <Grid>
                <Border Classes="content-background" />
                <Grid RowDefinitions="*,Auto" Margin="{StaticResource ThemePadding-Medium}">
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <StackPanel Spacing="{StaticResource ThemeSize-Regular}">
                            <TextBlock x:Name="HeadingText"
                                       Classes="ONE-H2-Bold" />
                            <Border Classes="error-block" Padding="8">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="ErrorTitleText"
                                               Classes="ONE-Paragraph-Bold" Foreground="{StaticResource RedColor}" />
                                    <TextBlock x:Name="ErrorDescText"
                                               TextWrapping="Wrap" Classes="ONE-H3-Regular" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <local:MessageBlockView x:Name="ErrorBlock" Grid.Row="1" Severity="Error" />
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="{StaticResource ThemePaddingSides-Medium}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="Secondary Large" x:Name="ShowLogButton" />
                    <Button Classes="Primary Large" x:Name="CloseButton" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>





