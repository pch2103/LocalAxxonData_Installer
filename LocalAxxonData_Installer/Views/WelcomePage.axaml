<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalAxxonData_Installer.Views"
             Width="700" Height="500"
             x:Class="LocalAxxonData_Installer.Views.WelcomePage">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <local:StageTitleBar Grid.Row="0" />
        <local:ColorBandView x:Name="ColorBand" Grid.Row="1"
                             HeaderBrush="#1A73E8"
                             BackgroundImageSource="header_back_blue.png" ShowLogo="True" />
        <Border Grid.Row="2" Margin="{StaticResource ThemePaddingDownAndSides-Medium}">
            <Grid>
                <Border Classes="content-background" />
                <Grid RowDefinitions="*,Auto" Margin="{StaticResource ThemePadding-Medium}">
                    <ScrollViewer Grid.Row="0">
                        <StackPanel Spacing="{StaticResource ThemeSize-Regular}">
                            <TextBlock x:Name="HeadingText"
                                       Classes="ONE-H2-Bold" />
                            <TextBlock x:Name="DescText"
                                       TextWrapping="Wrap" Classes="ONE-H3-Regular" />
                            <Border Classes="warning-block" Padding="8">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="WarningHeadingText"
                                               Classes="ONE-Paragraph-Bold" Foreground="{StaticResource OrangeColor}" />
                                    <TextBlock x:Name="WarningBodyText"
                                               TextWrapping="Wrap" Classes="ONE-H3-Regular" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <local:InfoBlockView x:Name="InfoBlock" Grid.Row="1" />
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="3" Margin="{StaticResource ThemePaddingSides-Medium}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="Primary Large" Click="OnNextClick">
                        <TextBlock x:Name="NextText" Text="Далее" Classes="ONE-H3-Bold" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="Secondary Large" x:Name="CancelButton" Click="OnCancelClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
