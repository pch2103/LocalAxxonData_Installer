<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalAxxonData_Installer.Views"
             x:Class="LocalAxxonData_Installer.Views.WarningBlockView">
    <Border Classes="warning-block">
        <Grid ColumnDefinitions="Auto, *">
            <PathIcon Grid.Column="0" VerticalAlignment="Top" Margin="0 0 8 0" Data="{DynamicResource WarningIcon}"
                      Foreground="{DynamicResource OrangeColor}"
                      Width="20" Height="20" />
            <StackPanel Grid.Column="1">
                <TextBlock TextWrapping="Wrap" Classes="ONE-Paragraph-Bold"
                           Text="{Binding HeaderText, RelativeSource={RelativeSource AncestorType=local:WarningBlockView}}" />
                <TextBlock TextWrapping="Wrap" Classes="ONE-Paragraph-Regular"
                           Text="{Binding BodyText, RelativeSource={RelativeSource AncestorType=local:WarningBlockView}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
