<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalAxxonData_Installer.Views"
             Width="700"
             x:Class="LocalAxxonData_Installer.Views.AlreadyInstalledPage">
    <Grid RowDefinitions="*,Auto">

        
        <Border Grid.Row="0" Margin="{StaticResource ThemePaddingDownAndSides-Medium}">
            <Grid>
                <Border Classes="content-background" />
                <Grid Margin="{StaticResource ThemePadding-Medium}" VerticalAlignment="Center">
                    <StackPanel Spacing="{StaticResource ThemeSize-Regular}">
                        <TextBlock x:Name="TitleText"
                                   Classes="ONE-H2-Bold" />
                        <TextBlock TextWrapping="Wrap" Classes="ONE-H3-Regular"
                                   x:Name="DescText" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                            <Button Classes="Primary Large" x:Name="RestoreButton" Click="OnRestoreClick" />
                            <Button Classes="Danger Large" x:Name="UninstallButton" Click="OnUninstallClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="{StaticResource ThemePaddingSides-Medium}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="Secondary Large" x:Name="ExitButton" Click="OnExitClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>



