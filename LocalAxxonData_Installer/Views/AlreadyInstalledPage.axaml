<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalAxxonData_Installer.Views"
             Width="700" Height="500"
             x:Class="LocalAxxonData_Installer.Views.AlreadyInstalledPage">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <local:StageTitleBar Grid.Row="0" />
        <local:ColorBandView Grid.Row="1"
                             HeaderBrush="#1565C0"
                             HeaderText="Local AxxonData"
                             BodyText="Обнаружена существующая установка"
                             ShowLogo="True" />
        <Border Grid.Row="2" Margin="{StaticResource ThemePaddingDownAndSides-Medium}">
            <Grid>
                <Border Classes="content-background" />
                <Grid Margin="{StaticResource ThemePadding-Medium}" VerticalAlignment="Center">
                    <StackPanel Spacing="{StaticResource ThemeSize-Regular}">
                        <TextBlock Text="Local AxxonData уже установлен"
                                   Classes="ONE-H2-Bold" />
                        <TextBlock TextWrapping="Wrap" Classes="ONE-H3-Regular"
                                   Text="На этом компьютере уже установлен Local AxxonData. Вы можете удалить существующую установку или запустить повторную настройку." />
                        <Border Classes="info-block" Padding="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Текущая установка"
                                           Classes="ONE-Paragraph-Bold" />
                                <TextBlock TextWrapping="Wrap" Classes="ONE-Paragraph-Regular"
                                           Text="Версия: 1.2.0" />
                                <TextBlock TextWrapping="Wrap" Classes="ONE-Paragraph-Regular"
                                           Text="Установлен: 15.06.2026" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="3" Margin="{StaticResource ThemePaddingSides-Medium}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="Secondary Large" Content="Удалить" Click="OnUninstallClick" />
                    <Button Classes="Secondary Large" Content="Выйти" Click="OnExitClick" />
                    <Button Classes="Primary Large" Content="Продолжить" Click="OnContinueClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
