<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalAxxonData_Installer.Views"
             x:Class="LocalAxxonData_Installer.Views.MessageBlockView">
    <Border x:Name="BlockBorder">
        <Grid ColumnDefinitions="Auto, *">
            <PathIcon x:Name="BlockIcon" Grid.Column="0" VerticalAlignment="Top"
                      Margin="0 0 8 0" Width="20" Height="20" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeaderBlock" TextWrapping="Wrap" Classes="ONE-Paragraph-Bold" />
                <TextBlock x:Name="BodyBlock" TextWrapping="Wrap" Classes="ONE-Paragraph-Regular" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
