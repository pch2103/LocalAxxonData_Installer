<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:LocalAxxonData_Installer.Views"
             x:Class="LocalAxxonData_Installer.Views.InfoBlockView">
    <Border Classes="info-block">
        <Grid ColumnDefinitions="Auto, *">
            <PathIcon Grid.Column="0" VerticalAlignment="Top" Margin="0 0 8 0" Data="{DynamicResource InfoIcon}"
                      Foreground="{DynamicResource PrimaryColorTint20}"
                      Width="20" Height="20" />
            <StackPanel Grid.Column="1">
                <TextBlock TextWrapping="Wrap" Classes="ONE-Paragraph-Bold"
                           Text="{Binding HeaderText, RelativeSource={RelativeSource AncestorType=local:InfoBlockView}}" />
                <TextBlock TextWrapping="Wrap" Classes="ONE-Paragraph-Regular"
                           Text="{Binding BodyText, RelativeSource={RelativeSource AncestorType=local:InfoBlockView}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
