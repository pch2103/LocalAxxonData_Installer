<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalAxxonData_Installer.Views"
             Width="700" Height="500"
             x:Class="LocalAxxonData_Installer.Views.ExitConfirmPage">
    <Grid RowDefinitions="Auto,*,Auto">
        <local:ColorBandView Grid.Row="0"
                             HeaderBrush="#616161"
                             HeaderText="Прервать установку?"
                             BackgroundImageSource="header_back_gray.png" ShowLogo="True" />
        <Border Grid.Row="1" Margin="{StaticResource ThemePaddingDownAndSides-Medium}">
            <Grid>
                <Border Classes="content-background" />
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Spacing="{StaticResource ThemeSize-Regular}" HorizontalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="48" HorizontalAlignment="Center" />
                        <TextBlock Text="Вы уверены, что хотите выйти?"
                                   Classes="ONE-H2-Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="Установка будет прервана."
                                   Classes="ONE-H3-Regular" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2" Margin="{StaticResource ThemePaddingSides-Medium}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="Secondary Large" Content="Выйти" Click="OnExitClick" />
                <Button Classes="Primary Large" Content="Продолжить установку" Click="OnContinueClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
