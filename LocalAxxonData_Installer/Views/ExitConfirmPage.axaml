<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalAxxonData_Installer.Views"
             Width="700"
             x:Class="LocalAxxonData_Installer.Views.ExitConfirmPage">
    <Grid RowDefinitions="*,Auto">
        <Border Grid.Row="0" Margin="{StaticResource ThemePaddingDownAndSides-Medium}">
            <Grid>
                <Border Classes="content-background" />
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Spacing="{StaticResource ThemeSize-Regular}" HorizontalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="48" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TitleText"
                                   Classes="ONE-H2-Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="DescText"
                                   Classes="ONE-H3-Regular" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="{StaticResource ThemePaddingSides-Medium}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="Secondary Large" x:Name="ExitButton" Click="OnExitClick" />
                <Button Classes="Primary Large" x:Name="ContinueButton" Click="OnContinueClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

