<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalAxxonData_Installer.Views"
             Width="700"
             x:Class="LocalAxxonData_Installer.Views.RebootPage">
    <Grid RowDefinitions="*,Auto">

        
        <Border Grid.Row="0" Margin="{StaticResource ThemePaddingDownAndSides-Medium}">
                <Grid>
                    <Border Classes="content-background" />
                    <Grid RowDefinitions="*,Auto,*" HorizontalAlignment="Center">
                        <StackPanel Grid.Row="1" Spacing="{StaticResource ThemeSize-Regular}" HorizontalAlignment="Center">
                            <TextBlock Text="⟳" FontSize="48" Foreground="{StaticResource OrangeColor}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="HeadingText"
                                       Classes="ONE-H2-Bold" HorizontalAlignment="Center" />
                            <Border Classes="warning-block" Padding="16" HorizontalAlignment="Center" MinWidth="200">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock x:Name="CountdownLabelText"
                                               Classes="ONE-Paragraph-Regular" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TimerText" Text="60 сек."
                                               Classes="ONE-H1-Medium" Foreground="{StaticResource OrangeColor}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="InfoText"
                                       Classes="ONE-Paragraph-Small" Foreground="{StaticResource SubLabelColor}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
        </Border>
        <Border Grid.Row="1" Margin="{StaticResource ThemePaddingSides-Medium}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="DeferButton" Classes="Secondary Large" Content="Отложить" Click="OnDeferClick" />
                    <Button x:Name="RebootButton" Classes="Primary Large" Content="Перезагрузить" Click="OnRebootClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>



