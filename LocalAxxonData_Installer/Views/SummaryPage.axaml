<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LocalAxxonData_Installer.Views"
             Width="700"
             x:Class="LocalAxxonData_Installer.Views.SummaryPage">
    <Grid RowDefinitions="*,Auto">

        
        <Border Grid.Row="0" Margin="{StaticResource ThemePaddingDownAndSides-Medium}">
            <Grid>
                <Border Classes="content-background" />
                <Grid RowDefinitions="*,Auto" Margin="{StaticResource ThemePadding-Medium}">
                    <ScrollViewer Grid.Row="0">
                        <StackPanel Spacing="{StaticResource ThemeSize-Regular}">
                            <TextBlock x:Name="HeadingText"
                                       Classes="ONE-H2-Bold" />
                            <Border Classes="info-block" Padding="8">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="InfoHeaderText"
                                               Classes="ONE-Paragraph-Bold" />
                                    <TextBlock x:Name="DirText"
                                               TextWrapping="Wrap" Classes="ONE-Paragraph-Regular" />
                                    <TextBlock x:Name="SmtpText"
                                               TextWrapping="Wrap" Classes="ONE-Paragraph-Regular" />
                                    <TextBlock x:Name="PasswordText"
                                               TextWrapping="Wrap" Classes="ONE-Paragraph-Regular" />
                                </StackPanel>
                            </Border>
                            <Border Classes="warning-block" Padding="8">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="WarningHeadingText"
                                               Classes="ONE-Paragraph-Bold" Foreground="{StaticResource OrangeColor}" />
                                    <TextBlock x:Name="WarningBodyText"
                                               TextWrapping="Wrap" Classes="ONE-Paragraph-Regular" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <local:MessageBlockView x:Name="InfoBlock" Grid.Row="1" />
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="1" Margin="{StaticResource ThemePaddingSides-Medium}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Classes="Secondary Large" Click="OnBackClick">
                        <TextBlock x:Name="BackText" Text="Назад" Classes="ONE-H3-Bold" VerticalAlignment="Center" />
                    </Button>
                    <Button Classes="Primary Large" x:Name="InstallButton" Click="OnInstallClick" />
                    <Button Classes="Secondary Large" x:Name="CancelButton" Click="OnCancelClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>




