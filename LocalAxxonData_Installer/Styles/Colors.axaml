<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>

        <Color x:Key="ThemeBackgroundColor">#0A0A0A</Color>
        <Color x:Key="ThemeBackgroundColor-900">#191919</Color>
        <Color x:Key="ThemeBackgroundColor-800">#2A2A2A</Color>
        <Color x:Key="ThemeBackgroundColor-700">#3D3D3D</Color>
        <Color x:Key="ThemeBackgroundColor-600">#484848</Color>
        <Color x:Key="ThemeBackgroundColor-500">#656565</Color>
        <Color x:Key="ThemeBackgroundColor-400">#858585</Color>
        <Color x:Key="ThemeBackgroundColor-100">#D6D6D6</Color>
        <Color x:Key="ThemeBackgroundColorLight">#D6D6D6</Color>
        <Color x:Key="ThemeForegroundColor">#F6F6F6</Color>
        <Color x:Key="ThemeWhite">#FFFFFF</Color>

        <Color x:Key="ThemePrimaryColorTint20">#0082F7</Color>
        <Color x:Key="ThemePrimaryColorTint10">#0082F7</Color>
        <Color x:Key="ThemePrimaryColor">#0070E4</Color>
        <Color x:Key="ThemePrimaryColorShade10">#0053A8</Color>
        <Color x:Key="ThemePrimaryColorShade20">#004184</Color>

        <Color x:Key="ThemeRed">#FF0000</Color>
        <Color x:Key="ThemeGreen">#20D300</Color>
        <Color x:Key="ThemeOrange">#FF8A00</Color>

        <FontFamily x:Key="DefaultFont">Segoe UI, Roboto, San Francisco, sans-serif</FontFamily>

    </Styles.Resources>

</Styles>